# Environment Configuration Template
# Copy to .env and fill in your actual credentials. NEVER commit .env to git.

# Server Configurations
NODE_ENV=development
PORT=5000
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_SECRET=change_me_to_a_random_secure_64_char_secret_key

# Security & Authentication
JWT_SECRET=change_me_to_a_random_jwt_secret_key
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_db

# AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
EXTRACTION_MODEL=gemini-1.5-pro
