# Environment Configuration Template
# Copy to .env and fill in your actual credentials. NEVER commit .env to git.

# Server Configurations
NODE_ENV=development
PORT=5000
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_SECRET=dev_internal_api_secret_64_characters_long_key_change_in_prod

# Security & Authentication
JWT_SECRET=dev_jwt_secret_key_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:80

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/insurance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=insurance_db

# AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
EXTRACTION_MODEL=gemini-1.5-pro

# Phase 6: Cloud Vault & Secret Manager (Production Only)
# When configured in production, secrets are dynamically loaded from AWS Secrets Manager
AWS_REGION=ap-south-1
AWS_SECRETS_VAULT_NAME=policylens/production/app-secrets
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/policylens-production-ecs-execution-role
